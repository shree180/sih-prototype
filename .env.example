# ============================================================================
# DRM04 — combined env example. Copy to .env.local (web) / apps/ai/.env (ai).
# Never commit real secrets.
# ============================================================================

# --- Supabase (shared) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/POSTGRES?sslmode=require
# Local demo/test only. Production must use DATABASE_URL and leave this false.
ALLOW_IN_MEMORY_DB=false

# --- Next.js web ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace-with-a-long-random-shared-key
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_STORAGE_ORIGINALS=report-originals
NEXT_PUBLIC_STORAGE_REDACTED=report-redacted

# --- FastAPI AI service ---
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=vision-llm
AI_MODEL_VERSION=1.0
AI_BASE_URL=
CONFIDENCE_THRESHOLD=0.60
ENVIRONMENT=development
