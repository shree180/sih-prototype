# Public (browser-safe) Supabase keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only secrets (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# AI assessment service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace-with-a-long-random-shared-key

# Map style (MapLibre). A free OSM raster style works without an API key.
NEXT_PUBLIC_MAP_STYLE_URL=

# Storage buckets
NEXT_PUBLIC_STORAGE_ORIGINALS=report-originals
NEXT_PUBLIC_STORAGE_REDACTED=report-redacted
